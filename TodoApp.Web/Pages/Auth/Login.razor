@page "/login"
@rendermode InteractiveServer
@layout EmptyLayout
@using MudBlazor
@using TodoApp.Web.Auth
@using TodoApp.Web.Components.Layout
@using TodoApp.Web.Models
@using TodoApp.Web.Services
@inject IApiService ApiService
@inject CustomAuthStateProvider AuthProvider
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Elevation="8" Class="pa-8" Style="border-radius:16px;">

        <!-- Logo & Title -->
        <div class="d-flex flex-column align-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                     Color="Color.Primary" Style="font-size:3rem;" />
            <MudText Typo="Typo.h4" Class="mt-2 font-weight-bold">TodoApp</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Sign in to your account
            </MudText>
        </div>

        <!-- Form -->
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudTextField @bind-Value="_model.Email"
                          Label="Email Address"
                          InputType="InputType.Email"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          Required="true"
                          Class="mb-4" />

            <MudTextField @bind-Value="_model.Password"
                          Label="Password"
                          InputType="@_passwordType"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_passwordIcon"
                          OnAdornmentClick="TogglePassword"
                          Required="true"
                          Class="mb-2" />

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">
                    @_errorMessage
                </MudAlert>
            }

            <MudButton FullWidth="true"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       OnClick="HandleLogin"
                       Disabled="_isLoading"
                       Class="mt-4"
                       Style="border-radius:8px; height:48px;">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small"
                                         Indeterminate="true" Class="mr-2" />
                }
                Sign In
            </MudButton>
        </MudForm>

        <MudDivider Class="my-4" />

        <div class="d-flex justify-center">
            <MudText Typo="Typo.body2">Don't have an account?</MudText>
            <MudLink Href="/register" Class="ml-1">Register</MudLink>
        </div>
    </MudPaper>
</MudContainer>

@code {
    private MudForm _form = null!;
    private LoginModel _model = new();
    private bool _isValid;
    private bool _isLoading;
    private string _errorMessage = string.Empty;
    private InputType _passwordType = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    private string? ReturnUrl { get; set; }

    private void TogglePassword()
    {
        if (_passwordType == InputType.Password)
        {
            _passwordType = InputType.Text;
            _passwordIcon = Icons.Material.Filled.Visibility;
        }
        else
        {
            _passwordType = InputType.Password;
            _passwordIcon = Icons.Material.Filled.VisibilityOff;
        }
    }

    private async Task HandleLogin()
    {
        await _form.Validate();
        if (!_isValid) return;

        _isLoading = true;
        _errorMessage = string.Empty;

        try
        {
            var result = await ApiService.LoginAsync(_model);

            if (result is null || string.IsNullOrEmpty(result.Token))
            {
                _errorMessage = "Invalid email or password.";
                return;
            }

            await AuthProvider.MarkAsAuthenticatedAsync(result.Token);

            // Tanpa forceLoad agar auth state tidak reset
            var redirectUrl = string.IsNullOrEmpty(ReturnUrl) ? "/todos" : ReturnUrl;
            Nav.NavigateTo(redirectUrl, forceLoad: false);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            _errorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
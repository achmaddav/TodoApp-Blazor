@page "/login"
@rendermode InteractiveServer
@layout EmptyLayout
@using MudBlazor
@using TodoApp.Web.Auth
@using TodoApp.Web.Components.Layout
@using TodoApp.Web.Models
@using TodoApp.Web.Services
@inject IApiService ApiService
@inject CustomAuthStateProvider AuthProvider
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<div class="login-wrapper">
    <div class="login-left d-none d-md-flex">
        <div class="d-flex flex-column align-center justify-center" style="gap:24px;">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                     Style="font-size:5rem; color:white;" />
            <MudText Typo="Typo.h3" Class="font-weight-bold"
                     Style="color:white;">TodoApp</MudText>
            <MudText Typo="Typo.h6"
                     Style="color:rgba(255,255,255,0.8); text-align:center; max-width:300px;">
                Manage your tasks efficiently and stay productive
            </MudText>

            <!-- Feature List -->
            <div class="d-flex flex-column" style="gap:16px; margin-top:16px;">
                @foreach (var feature in _features)
                {
                    <div class="d-flex align-center" style="gap:12px;">
                        <MudAvatar Style="background:rgba(255,255,255,0.2);
                                color:white;" Size="Size.Small">
                            <MudIcon Icon="@feature.Icon" Size="Size.Small" />
                        </MudAvatar>
                        <MudText Style="color:rgba(255,255,255,0.9);">
                            @feature.Text
                        </MudText>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Side - Login Form -->
    <div class="login-right">
        <div class="login-form-container">

            <!-- Mobile Logo -->
            <div class="d-flex d-md-none flex-column align-center mb-6">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                         Color="Color.Primary" Style="font-size:3rem;" />
                <MudText Typo="Typo.h5" Class="mt-2 font-weight-bold">
                    TodoApp
                </MudText>
            </div>

            <!-- Title -->
            <MudText Typo="Typo.h4" Class="font-weight-bold mb-2">
                Welcome back 👋
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-8">
                Sign in to continue to your dashboard
            </MudText>

            <!-- Error Alert -->
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4"
                          Variant="Variant.Filled" Dense="true">
                    @_errorMessage
                </MudAlert>
            }

            <!-- Form -->
            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudText Typo="Typo.body2" Class="font-weight-medium mb-1">
                    Email Address
                </MudText>
                <MudTextField @bind-Value="_model.Email"
                              Placeholder="you@example.com"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Required="true"
                              FullWidth="true"
                              Class="mb-4" />

                <div class="d-flex justify-space-between align-center mb-1">
                    <MudText Typo="Typo.body2" Class="font-weight-medium">
                        Password
                    </MudText>
                </div>
                <MudTextField @bind-Value="_model.Password"
                              Placeholder="Enter your password"
                              InputType="@_passwordType"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordIcon"
                              OnAdornmentClick="TogglePassword"
                              Required="true"
                              FullWidth="true"
                              Class="mb-6" />

                <MudButton FullWidth="true"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           OnClick="HandleLogin"
                           Disabled="_isLoading"
                           Style="border-radius:10px; height:52px; font-size:1rem;">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small"
                                             Indeterminate="true" Class="mr-2" />
                        <span>Signing in...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Login"
                                 Class="mr-2" Size="Size.Small" />
                        <span>Sign In</span>
                    }
                </MudButton>
            </MudForm>

            <MudDivider Class="my-6" />

            <div class="d-flex justify-center align-center" style="gap:6px;">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Don't have an account?
                </MudText>
                <MudLink Href="/register" Typo="Typo.body2"
                         Style="color:#6366F1; font-weight:600;">
                    Create account
                </MudLink>
            </div>

        </div>
    </div>
</div>

<style>
    .login-wrapper {
        display: flex;
        min-height: 100vh;
        background: #F8FAFC;
    }

    .login-left {
        flex: 1;
        background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 60%, #EC4899 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px;
        position: relative;
        overflow: hidden;
    }

        .login-left::before {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
            top: -100px;
            right: -100px;
        }

        .login-left::after {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
            bottom: -80px;
            left: -80px;
        }

    .login-right {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 24px;
        background: #FFFFFF;
    }

    .login-form-container {
        width: 100%;
        max-width: 420px;
    }

    @@media (max-width: 960px) {
        .login-left {
            display: none !important;
        }

        .login-right {
            background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
        }

        .login-form-container {
            background: white;
            border-radius: 20px;
            padding: 40px 32px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.15);
        }
    }
</style>

@code {
    private MudForm _form = null!;
    private LoginModel _model = new();
    private bool _isValid;
    private bool _isLoading;
    private string _errorMessage = string.Empty;
    private InputType _passwordType = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    private string? ReturnUrl { get; set; }

    private readonly List<(string Icon, string Text)> _features = new()
    {
        (Icons.Material.Filled.CheckCircle,  "Track all your tasks in one place"),
        (Icons.Material.Filled.Category,     "Organize with categories"),
        (Icons.Material.Filled.Notifications,"Get reminded before due dates"),
        (Icons.Material.Filled.BarChart,     "Monitor your productivity"),
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
                Nav.NavigateTo("/dashboard", forceLoad: false);
        }
    }

    private void TogglePassword()
    {
        if (_passwordType == InputType.Password)
        {
            _passwordType = InputType.Text;
            _passwordIcon = Icons.Material.Filled.Visibility;
        }
        else
        {
            _passwordType = InputType.Password;
            _passwordIcon = Icons.Material.Filled.VisibilityOff;
        }
    }

    private async Task HandleLogin()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        _isLoading = true;
        _errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var result = await ApiService.LoginAsync(_model);

            if (result is null || string.IsNullOrEmpty(result.Token))
            {
                _errorMessage = "Invalid email or password. Please try again.";
                return;
            }

            await AuthProvider.MarkAsAuthenticatedAsync(result.Token);
            await Task.Delay(100);

            var redirectUrl = string.IsNullOrEmpty(ReturnUrl) ? "/dashboard" : ReturnUrl;
            Nav.NavigateTo(redirectUrl, forceLoad: false);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Login Error: {ex.Message}");
            _errorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}
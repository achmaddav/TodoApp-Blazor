@page "/categories"
@rendermode InteractiveServer
@namespace TodoApp.Web.Pages.Categories
@using TodoApp.Web.Models
@using TodoApp.Web.Services
@using MudBlazor
@inject IApiService ApiService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Categories</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    <!-- Header -->
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Class="font-weight-bold">Categories</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Manage your todo categories
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog"
                   Style="border-radius:8px;">
            New Category
        </MudButton>
    </div>

    <!-- Loading -->
    @if (_isLoading)
    {
        <div class="d-flex justify-center mt-8">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else if (!_categories.Any())
    {
        <MudPaper Elevation="0" Class="pa-12 text-center"
                  Style="border-radius:12px; border: 2px dashed #e0e0e0;">
            <MudIcon Icon="@Icons.Material.Filled.Category"
                     Style="font-size:4rem; color:#bdbdbd;" />
            <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">
                No categories yet
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Class="mt-4" OnClick="OpenCreateDialog">
                Create First Category
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            @foreach (var category in _categories)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudPaper Elevation="3" Class="pa-4"
                              Style="@GetCardStyle(category.Color)">
                        <div class="d-flex justify-space-between align-center">
                            <div class="d-flex align-center" style="gap:12px;">
                                <MudAvatar Style="@GetAvatarStyle(category.Color)">
                                    <MudIcon Icon="@Icons.Material.Filled.Label" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">
                                        @category.Name
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @category.TodoCount todo(s)
                                    </MudText>
                                </div>
                            </div>
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                     Size="Size.Small">
                                <MudMenuItem OnClick="@(() => OpenEditDialog(category))">
                                    <div class="d-flex align-center" style="gap:8px;">
                                        <MudIcon Icon="@Icons.Material.Filled.Edit"
                                                 Size="Size.Small" />
                                        Edit
                                    </div>
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => DeleteCategory(category.Id))">
                                    <div class="d-flex align-center"
                                         style="gap:8px; color:#f44336;">
                                        <MudIcon Icon="@Icons.Material.Filled.Delete"
                                                 Size="Size.Small" Color="Color.Error" />
                                        Delete
                                    </div>
                                </MudMenuItem>
                            </MudMenu>
                        </div>

                        @if (!string.IsNullOrEmpty(category.Description))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary"
                                     Class="mt-3">
                                @category.Description
                            </MudText>
                        }

                        <MudDivider Class="my-3" />

                        <div class="d-flex align-center" style="gap:8px;">
                            <MudChip T="string" Size="Size.Small"
                                     Style="@GetChipStyle(category.Color)">
                                @category.Color
                            </MudChip>
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private List<CategoryModel> _categories = new();
    private bool _isLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadCategoriesAsync();
            StateHasChanged();
        }
    }

    private async Task LoadCategoriesAsync()
    {
        _isLoading = true;
        try
        {
            var result = await ApiService.GetCategoriesAsync();
            _categories = result ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Load categories error: {ex.Message}");
            Snackbar.Add("Failed to load categories.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<CategoryDialog>(
            "New Category",
            new DialogParameters(),
            new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraSmall,
                FullWidth = true,
                CloseButton = true
            });

        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadCategoriesAsync();
    }

    private async Task OpenEditDialog(CategoryModel category)
    {
        var parameters = new DialogParameters
        {
            ["Category"] = category
        };
        var dialog = await DialogService.ShowAsync<CategoryDialog>(
            "Edit Category", parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraSmall,
                FullWidth = true,
                CloseButton = true
            });

        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadCategoriesAsync();
    }

    private async Task DeleteCategory(Guid id)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = "Are you sure you want to delete this category?",
            ["ButtonText"] = "Delete",
            ["Color"] = Color.Error
        };
        var dialog = await DialogService.ShowAsync<MudBlazor.MudMessageBox>(
            "Confirm Delete", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            var success = await ApiService.DeleteCategoryAsync(id);
            if (success)
            {
                Snackbar.Add("Category deleted.", Severity.Info);
                await LoadCategoriesAsync();
                StateHasChanged();
            }
            else Snackbar.Add("Failed to delete category.", Severity.Error);
        }
    }

    private static string GetCardStyle(string color) =>
        $"border-radius:12px; border-left:4px solid {color}; transition:all 0.2s ease;";

    private static string GetAvatarStyle(string color) =>
        $"background:{color}22; color:{color};";

    private static string GetChipStyle(string color) =>
        $"background:{color}22; color:{color}; height:22px;";
}
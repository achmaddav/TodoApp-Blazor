@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                // Sudah login, ke dashboard
                Nav.NavigateTo("/dashboard", forceLoad: false);
            }
            else
            {
                // Belum login, ke login page
                var currentPath = new Uri(Nav.Uri).PathAndQuery;
                var returnUrl = Uri.EscapeDataString(currentPath);
                Nav.NavigateTo($"/login?ReturnUrl={returnUrl}", forceLoad: false);
            }
        }
    }
}

@inherits LayoutComponentBase
@using TodoApp.Web.Auth
@inject CustomAuthStateProvider AuthProvider
@inject NavigationManager Nav

<MudThemeProvider Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <!-- Top Bar -->
            <MudAppBar Elevation="2" Style="background: linear-gradient(135deg, #6366F1, #8B5CF6);">
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                    Color="Color.Inherit" Edge="Edge.Start"
                    OnClick="ToggleDrawer" />
                <MudText Typo="Typo.h6" Class="ml-2 font-weight-bold">
                    ✅ TodoApp
                </MudText>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                    Color="Color.Inherit" />
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                    Color="Color.Inherit" Direction="Direction.Bottom">
                    <MudMenuItem OnClick="Logout">
                        <div class="d-flex align-center" style="gap:8px;">
                            <MudIcon Icon="@Icons.Material.Filled.Logout" />
                            Logout
                        </div>
                    </MudMenuItem>
                </MudMenu>
            </MudAppBar>

            <!-- Side Drawer -->
            <MudDrawer @bind-Open="_drawerOpen" Elevation="2"
                Style="border-right: 1px solid #f0f0f0;">
                <MudDrawerHeader>
                    <MudText Typo="Typo.h6" Class="font-weight-bold"
                        Style="color:#6366F1;">Navigation</MudText>
                </MudDrawerHeader>
                <NavMenu />
            </MudDrawer>

            <MudMainContent>
                <div style="padding: 20px;">
                    @Body
                </div>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#6366F1",
            Secondary = "#8B5CF6",
            Success = "#10B981",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            AppbarBackground = "#6366F1"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#6366F1",
            Secondary = "#8B5CF6",
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task Logout()
    {
        await AuthProvider.MarkAsLoggedOutAsync();
        Nav.NavigateTo("/login", true);
    }
}
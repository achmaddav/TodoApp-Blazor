@inherits LayoutComponentBase
@using System.Security.Claims
@using TodoApp.Web.Auth
@inject CustomAuthStateProvider AuthProvider
@inject NavigationManager Nav

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView Context="authContext">
    <Authorized>
        <MudLayout>

            <!-- AppBar -->
            <MudAppBar Elevation="0"
                Style="background:rgba(255,255,255,0.95);
                    backdrop-filter:blur(10px);
                    border-bottom:1px solid #E2E8F0;">
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                    Color="Color.Inherit" Edge="Edge.Start"
                    OnClick="ToggleDrawer"
                    Style="color:#64748B;" />

                <div class="d-flex align-center ml-2" style="gap:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                        Style="color:#6366F1; font-size:1.6rem;" />
                    <MudText Typo="Typo.h6" Class="font-weight-bold"
                        Style="color:#6366F1; letter-spacing:-0.3px;">
                        TodoApp
                    </MudText>
                </div>

                <MudSpacer />

                <!-- User Info + Avatar -->
                <div class="d-flex align-center" style="gap:12px;">
                    <div class="d-none d-sm-flex flex-column align-end">
                        <MudText Typo="Typo.body2" Class="font-weight-bold"
                            Style="color:#1E293B; line-height:1.2;">
                            @authContext.User.Identity?.Name
                        </MudText>
                        <MudText Typo="Typo.caption"
                            Style="color:#94A3B8; font-size:0.7rem;">
                            @GetEmail(authContext.User)
                        </MudText>
                    </div>

                    <div class="appbar-avatar-btn"
                        @onclick="ToggleUserMenu">
                        <MudAvatar Style="background:linear-gradient(135deg,#6366F1,#8B5CF6);
                            color:white; width:38px; height:38px;
                            font-size:0.9rem; font-weight:600;
                            box-shadow:0 2px 8px rgba(99,102,241,0.4);">
                            @GetInitials(authContext.User.Identity?.Name)
                        </MudAvatar>
                    </div>
                </div>

                <!-- AppBar Dropdown Popover -->
                <MudPopover Open="_userMenuOpen"
                    AnchorOrigin="Origin.BottomRight"
                    TransformOrigin="Origin.TopRight"
                    Style="border-radius:16px; overflow:hidden;
                        box-shadow:0 20px 60px rgba(0,0,0,0.15);
                        min-width:260px; margin-top:8px;">
                    <MudClickAwayListener OnClickAway="CloseUserMenu">
                        <!-- Gradient Header -->
                        <div style="background:linear-gradient(135deg,#6366F1,#8B5CF6);
                            padding:20px;">
                            <div class="d-flex align-center" style="gap:12px;">
                                <MudAvatar Style="background:rgba(255,255,255,0.2);
                                    color:white; width:46px; height:46px;
                                    font-size:1.1rem; font-weight:600;
                                    border:2px solid rgba(255,255,255,0.3);">
                                    @GetInitials(authContext.User.Identity?.Name)
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.body1"
                                        Class="font-weight-bold"
                                        Style="color:white; line-height:1.3;">
                                        @authContext.User.Identity?.Name
                                    </MudText>
                                    <MudText Typo="Typo.caption"
                                        Style="color:rgba(255,255,255,0.7);
                                            font-size:0.72rem;">
                                        @GetEmail(authContext.User)
                                    </MudText>
                                </div>
                            </div>
                        </div>

                        <!-- Menu Items -->
                        <div style="background:white; padding:8px 0;">
                            <div class="popover-menu-item"
                                @onclick='() => { Nav.NavigateTo("/dashboard"); CloseUserMenu(); }'>
                                <MudIcon Icon="@Icons.Material.Filled.Dashboard"
                                    Style="color:#6366F1; font-size:1.1rem;" />
                                <span>Dashboard</span>
                            </div>
                            <div class="popover-menu-item"
                                @onclick='() => { Nav.NavigateTo("/todos"); CloseUserMenu(); }'>
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                    Style="color:#10B981; font-size:1.1rem;" />
                                <span>My Todos</span>
                            </div>
                            <div class="popover-menu-item"
                                @onclick='() => { Nav.NavigateTo("/categories"); CloseUserMenu(); }'>
                                <MudIcon Icon="@Icons.Material.Filled.Category"
                                    Style="color:#F59E0B; font-size:1.1rem;" />
                                <span>Categories</span>
                            </div>
                            <div class="popover-menu-item"
                                @onclick='() => { Nav.NavigateTo("/settings"); CloseUserMenu(); }'>
                                <MudIcon Icon="@Icons.Material.Filled.Settings"
                                    Style="color:#64748B; font-size:1.1rem;" />
                                <span>Settings</span>
                            </div>

                            <div style="height:1px; background:#F1F5F9;
                                margin:6px 16px;"></div>

                            <div class="popover-menu-item popover-menu-danger"
                                @onclick='() => { Logout(); CloseUserMenu(); }'>
                                <MudIcon Icon="@Icons.Material.Filled.Logout"
                                    Style="color:#EF4444; font-size:1.1rem;" />
                                <span>Sign out</span>
                            </div>
                        </div>
                    </MudClickAwayListener>
                </MudPopover>

            </MudAppBar>

            <!-- Sidebar Drawer -->
            <MudDrawer @bind-Open="_drawerOpen"
                Variant="DrawerVariant.Responsive"
                Elevation="0"
                Style="background:linear-gradient(180deg,#1E1B4B 0%,#2D2A6E 50%,#312E81 100%);
                    border-right:none;">

                <!-- Drawer Header -->
                <div class="d-flex align-center pa-4"
                    style="gap:10px; min-height:64px;
                        border-bottom:1px solid rgba(255,255,255,0.07);">
                    <div style="background:linear-gradient(135deg,#6366F1,#8B5CF6);
                        border-radius:10px; padding:6px; display:flex;">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                            Style="color:white; font-size:1.3rem;" />
                    </div>
                    <MudText Typo="Typo.h6" Class="font-weight-bold"
                        Style="color:white; letter-spacing:-0.3px;">
                        TodoApp
                    </MudText>
                </div>

                <!-- Nav Links -->
                <div class="px-3 mt-3" style="flex:1; overflow-y:auto;">
                    <NavMenu />
                </div>

                <!-- Drawer Footer Panel Menu -->
                @if (_drawerUserMenuOpen)
                {
                    <div style="background:rgba(255,255,255,0.05);
                        border-top:1px solid rgba(255,255,255,0.07);
                        padding:6px 12px;
                        animation: slideUp 0.2s ease;">
                        <div class="drawer-menu-item"
                            @onclick='() => { Nav.NavigateTo("/settings"); CloseDrawerUserMenu(); }'>
                            <MudIcon Icon="@Icons.Material.Filled.Settings"
                                Style="color:rgba(255,255,255,0.7);
                                    font-size:1rem;" />
                            <span style="color:rgba(255,255,255,0.85);
                                font-size:0.875rem;">
                                Settings
                            </span>
                        </div>
                        <div style="height:1px;
                            background:rgba(255,255,255,0.07);
                            margin:4px 8px;"></div>
                        <div class="drawer-menu-item drawer-menu-danger"
                            @onclick='() => { Logout(); CloseDrawerUserMenu(); }'>
                            <MudIcon Icon="@Icons.Material.Filled.Logout"
                                Style="color:#FCA5A5; font-size:1rem;" />
                            <span style="color:#FCA5A5; font-size:0.875rem;">
                                Sign out
                            </span>
                        </div>
                    </div>
                }

                <!-- Drawer Footer User Info -->
                <div style="border-top:1px solid rgba(255,255,255,0.07);">
                    <div class="drawer-footer-btn"
                        @onclick="ToggleDrawerUserMenu"
                        @onmouseenter='() => _drawerFooterHover = true'
                        @onmouseleave='() => _drawerFooterHover = false'
                        style="background:@(_drawerFooterHover
                            ? "rgba(255,255,255,0.07)" : "transparent");">
                        <div class="d-flex align-center"
                            style="gap:10px; overflow:hidden; flex:1;">
                            <MudAvatar Style="background:linear-gradient(135deg,#6366F1,#8B5CF6);
                                color:white; width:34px; height:34px;
                                font-size:0.8rem; font-weight:600;
                                flex-shrink:0;
                                box-shadow:0 2px 8px rgba(99,102,241,0.35);">
                                @GetInitials(authContext.User.Identity?.Name)
                            </MudAvatar>
                            <div style="overflow:hidden; flex:1;">
                                <MudText Typo="Typo.body2"
                                    Class="font-weight-medium"
                                    Style="color:white; line-height:1.3;
                                        white-space:nowrap; overflow:hidden;
                                        text-overflow:ellipsis;">
                                    @authContext.User.Identity?.Name
                                </MudText>
                                <MudText Typo="Typo.caption"
                                    Style="color:rgba(255,255,255,0.4);
                                        font-size:0.68rem;
                                        white-space:nowrap; overflow:hidden;
                                        text-overflow:ellipsis;">
                                    @GetEmail(authContext.User)
                                </MudText>
                            </div>
                        </div>
                        <MudIcon Icon="@(_drawerUserMenuOpen
                            ? Icons.Material.Filled.ExpandMore
                            : Icons.Material.Filled.ExpandLess)"
                            Style="color:rgba(255,255,255,0.35);
                                font-size:1.1rem; flex-shrink:0;
                                transition:transform 0.2s ease;" />
                    </div>
                </div>

            </MudDrawer>

            <!-- Main Content -->
            <MudMainContent Style="background:#F1F5F9; min-height:100vh;">
                <div style="padding:24px;">
                    @Body
                </div>
            </MudMainContent>

            <!-- Logout Confirmation Dialog -->
            <MudDialog @bind-Visible="_showLogoutDialog"
                Options="_dialogOptions">
                <TitleContent>
                    <div class="d-flex align-center" style="gap:12px;">
                        <MudAvatar Style="background:#FEE2E2; color:#EF4444;"
                            Size="Size.Small">
                            <MudIcon Icon="@Icons.Material.Filled.Logout"
                                Size="Size.Small" />
                        </MudAvatar>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                            Sign out
                        </MudText>
                    </div>
                </TitleContent>
                <DialogContent>
                    <MudText Typo="Typo.body1" Style="color:#475569;">
                        Are you sure you want to sign out?
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary"
                        Class="mt-1">
                        You will need to sign in again to continue.
                    </MudText>
                </DialogContent>
                <DialogActions>
                    <MudButton Variant="Variant.Text"
                        OnClick='() => _showLogoutDialog = false'
                        Style="border-radius:8px; color:#64748B;">
                        Cancel
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                        Color="Color.Error"
                        OnClick="ConfirmLogout"
                        Disabled="_isLoggingOut"
                        Style="border-radius:8px;">
                        @if (_isLoggingOut)
                        {
                            <MudProgressCircular Size="Size.Small"
                                Indeterminate="true" Class="mr-2" />
                            <span>Signing out...</span>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Logout"
                                Size="Size.Small" Class="mr-2" />
                            <span>Sign out</span>
                        }
                    </MudButton>
                </DialogActions>
            </MudDialog>

        </MudLayout>
    </Authorized>

    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

<style>
    /* AppBar Avatar Button */
    .appbar-avatar-btn {
        cursor: pointer;
        border-radius: 50%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .appbar-avatar-btn:hover {
        transform: scale(1.08);
        box-shadow: 0 4px 16px rgba(99,102,241,0.35);
    }

    /* AppBar Popover Menu Items */
    .popover-menu-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 20px;
        cursor: pointer;
        color: #334155;
        font-size: 0.875rem;
        font-weight: 500;
        transition: background 0.15s ease;
        border-radius: 0;
    }
    .popover-menu-item:hover {
        background: #F8FAFC;
    }
    .popover-menu-danger:hover {
        background: #FFF5F5;
        color: #EF4444;
    }

    /* Drawer Nav Links */
    .mud-nav-link {
        border-radius: 10px !important;
        margin-bottom: 2px !important;
        transition: background 0.15s ease !important;
    }
    .mud-nav-link.active {
        background: rgba(255,255,255,0.15) !important;
        color: white !important;
        font-weight: 600 !important;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1) !important;
    }
    .mud-nav-link:hover {
        background: rgba(255,255,255,0.08) !important;
    }

    /* Drawer Footer Button */
    .drawer-footer-btn {
        display: flex;
        align-items: center;
        padding: 14px 16px;
        cursor: pointer;
        transition: background 0.2s ease;
        gap: 8px;
    }

    /* Drawer Panel Menu Items */
    .drawer-menu-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.15s ease;
    }
    .drawer-menu-item:hover {
        background: rgba(255,255,255,0.08);
    }
    .drawer-menu-danger:hover {
        background: rgba(252,165,165,0.1);
    }

    /* Slide Up Animation */
    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* MudAppBar shadow */
    .mud-appbar {
        box-shadow: 0 1px 0 #E2E8F0 !important;
    }
</style>

@code {
    private bool _drawerOpen         = true;
    private bool _userMenuOpen       = false;
    private bool _drawerUserMenuOpen = false;
    private bool _drawerFooterHover  = false;
    private bool _showLogoutDialog   = false;
    private bool _isLoggingOut       = false;

    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth      = MaxWidth.ExtraSmall,
        FullWidth     = true,
        CloseButton   = false,
        BackdropClick = false,
        Position      = DialogPosition.Center,
    };

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary          = "#6366F1",
            Secondary        = "#8B5CF6",
            Success          = "#10B981",
            Warning          = "#F59E0B",
            Error            = "#EF4444",
            Background       = "#F1F5F9",
            Surface          = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void ToggleUserMenu()
    {
        _userMenuOpen = !_userMenuOpen;
        StateHasChanged();
    }

    private void CloseUserMenu()
    {
        _userMenuOpen = false;
        StateHasChanged();
    }

    private void ToggleDrawerUserMenu()
    {
        _drawerUserMenuOpen = !_drawerUserMenuOpen;
        StateHasChanged();
    }

    private void CloseDrawerUserMenu()
    {
        _drawerUserMenuOpen = false;
        StateHasChanged();
    }

    private void Logout() => _showLogoutDialog = true;

    private async Task ConfirmLogout()
    {
        _isLoggingOut = true;
        StateHasChanged();
        await Task.Delay(600);
        await AuthProvider.MarkAsLoggedOutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ',
            StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : name[..1].ToUpper();
    }

    private static string GetEmail(ClaimsPrincipal user)
        => user.FindFirst(ClaimTypes.Email)?.Value ?? string.Empty;
}